{
  "name": "psp-video-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "In-browser PSP Go video converter. Drag in videos, get 480x272 H.264 Baseline + AAC MP4s. 100% client-side via MediaBunny.",
  "scripts": {
    "dev": "bun --watch server.ts",
    "build": "bun build ./src/app.ts ./src/worker.ts --outdir ./public --target browser",
    "typecheck": "tsc --noEmit",
    "start": "bun server.ts"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "^1.55.7",
    "mediabunny": "^1.55.7"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "^5.6.0"
  }
}
