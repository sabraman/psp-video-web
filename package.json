{
  "name": "psp-video-web",
  "version": "1.0.0",
  "private": false,
  "description": "In-browser PSP video converter with WebCodecs, MediaBunny, direct USB storage streaming, and file management.",
  "keywords": [
    "aac",
    "client-side",
    "h264",
    "mediabunny",
    "playstation-portable",
    "psp",
    "tailwind",
    "tanstack-start",
    "video-converter",
    "webcodecs"
  ],
  "homepage": "https://psp.sabraman.art",
  "license": "MIT",
  "author": "sabraman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabraman/psp-video-web.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3005",
    "build": "bun build src/worker.ts --outfile public/worker.js --target browser && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "vite preview --port 3005",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@mediabunny/aac-encoder": "^1.55.7",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "mediabunny": "^1.55.7",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "latest",
    "nitro": "^3.0.260903-beta",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  }
}
