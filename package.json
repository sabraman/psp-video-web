{
  "name": "psp-video-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "In-browser PSP Go video converter. Drag in videos, get 480x272 H.264 Baseline + AAC MP4s. 100% client-side via MediaBunny.",
  "scripts": {
    "dev": "vite dev --port 3005",
    "build": "bun build src/worker.ts --outfile public/worker.js --target browser && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "vite preview --port 3005"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@mediabunny/aac-encoder": "^1.55.7",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "mediabunny": "^1.55.7",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "bun-types": "^1.4.2",
    "typescript": "^5.9.2",
    "vite": "^8"
  }
}
